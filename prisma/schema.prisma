generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  orderId     String   @id @map("order_id") // primary key = idempotent (duplicates are skipped)
  amount      Decimal  @db.Decimal(12, 2)
  consumer    String?
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("orders")
}

model FailedOrder {
  orderId  String   @id @map("order_id")
  payload  Json
  reason   String?
  failedAt DateTime @default(now()) @map("failed_at")

  @@map("failed_orders")
}
